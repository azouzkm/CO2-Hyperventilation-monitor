# Store text with LF line endings so the shell scripts and Python run on every laptop
# (a Windows checkout with CRLF endings breaks bash scripts).
* text=auto eol=lf

# Data files are evidence: keep them byte for byte, exactly as recorded.
*.csv -text
*.log -text

# Binary files: never convert them
*.png  binary
*.jpg  binary
*.jpeg binary
*.pdf  binary
*.stl  binary

# CAD exchange files are machine-written text: don't show them line by line in diffs
*.step -diff linguist-generated
