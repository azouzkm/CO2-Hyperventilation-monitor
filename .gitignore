# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# Local databases the service creates when it runs (not version-controlled)
*.sqlite
*.sqlite3
*.db
*.sqlite-wal
*.sqlite-shm
*.db-wal
*.db-shm

# Secrets: messaging API keys, Wi-Fi passwords. Never commit them.
.env
*.secret
settings.toml

# Large files: videos go in the submission ZIP, data goes in as CSV, photos as JPEG
*.mp4
*.mov
*.MOV
*.xlsx
*.heic
*.HEIC

# Note: raw bench logs in data/raw/ ARE committed. They are the evidence behind D7.

# Files the CircuitPython board writes on its own drive
boot_out.txt
.fseventsd/

# macOS and Windows
.DS_Store
._*
Thumbs.db
